{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Jwt": {
    "Issuer": "ytube-auth",
    "Audience": "ytube-clients",
    "SigningKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      // Public browsing = GET without login; everything else needs a token.
      // Lower "Order" is matched first, so specific routes beat the catch-alls.
      "videos-liked-route": {
        "ClusterId": "video-cluster",
        "AuthorizationPolicy": "default",
        "Order": 0,
        "Match": { "Path": "/api/videos/liked" }
      },
      "videos-read-route": {
        "ClusterId": "video-cluster",
        "AuthorizationPolicy": "anonymous",
        "Order": 1,
        "Match": { "Path": "/api/videos/{**catch-all}", "Methods": [ "GET" ] }
      },
      "videos-write-route": {
        "ClusterId": "video-cluster",
        "AuthorizationPolicy": "default",
        "Order": 2,
        "Match": { "Path": "/api/videos/{**catch-all}" }
      },
      "feed-subscriptions-route": {
        "ClusterId": "feed-cluster",
        "AuthorizationPolicy": "default",
        "Order": 0,
        "Match": { "Path": "/api/feed/subscriptions" }
      },
      "feed-route": {
        "ClusterId": "feed-cluster",
        "AuthorizationPolicy": "anonymous",
        "Order": 1,
        "Match": { "Path": "/api/feed/{**catch-all}", "Methods": [ "GET" ] }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "auth-1": { "Address": "http://localhost:5001/" } }
      },
      "user-cluster": {
        "Destinations": { "user-1": { "Address": "http://localhost:5002/" } }
      },
      "video-cluster": {
        "Destinations": { "video-1": { "Address": "http://localhost:5003/" } }
      },
      "feed-cluster": {
        "Destinations": { "feed-1": { "Address": "http://localhost:5004/" } }
      }
    }
  }
}
