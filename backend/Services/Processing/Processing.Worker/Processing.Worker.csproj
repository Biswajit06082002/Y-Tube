<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Worker host: no HTTP API. Consumes "video.uploaded" jobs from RabbitMQ and runs the BLL. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Processing.Worker-090ce475-f9bc-4936-8adc-1a5068364896</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Processing.BLL\Processing.BLL.csproj" />
    <ProjectReference Include="..\Processing.DAL\Processing.DAL.csproj" />
    <ProjectReference Include="..\Processing.Entities\Processing.Entities.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\YTube.Common\YTube.Common.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\YTube.Contracts\YTube.Contracts.csproj" />
  </ItemGroup>

</Project>
